DEEPSEEK_API_KEY=replace-with-api-key

APP_ENV=development
LLM_PROVIDER=deepseek
MODEL_NAME=deepseek-chat
RUNTIME_BACKEND=langgraph

# PostgreSQL 16+ with pgvector. Keep real credentials in the ignored .env file.
MEMORY_DATABASE_URL=postgresql://user:password@localhost:5433/agentdb
MEMORY_DATABASE_INITIALIZE=true

# Must exactly match the embedding provider output dimension.
MEMORY_EMBEDDING_DIMENSION=1024

# External embedding model service. Memory never loads this model locally.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_VERSION=latest
EMBEDDING_ENDPOINT=http://localhost:11434
EMBEDDING_TIMEOUT=30
